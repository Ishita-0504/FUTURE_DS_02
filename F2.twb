      <aliases enabled='yes' />
      <column caption='Total Customers' datatype='integer' name='[Calculation_2685338370805760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customerID])' />
      </column>
      <column caption='Churn Rate' datatype='real' default-format='p0.00%' name='[Calculation_2685338397032449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Churn] = &quot;Yes&quot;, 1, 0))&#13;&#10;/&#13;&#10;COUNTD([customerID])' />
      </column>
      <column caption='Churned Customer Calculation' datatype='integer' name='[Calculation_2685338581180418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Churn] = &quot;Yes&quot;&#13;&#10;    THEN [customerID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Retention Rate' datatype='real' default-format='p0.0%' name='[Calculation_2685338581581827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_2685338397032449]' />
      </column>
      <column caption='Churn Rate by Contract' datatype='real' name='[Calculation_2685338602369028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Contract] :&#13;&#10;    SUM(IIF([Churn] = &quot;Yes&quot;, 1, 0))&#13;&#10;    / COUNT([customerID])&#13;&#10;}' />
      </column>
      <column caption='Tenure Group' datatype='string' name='[Calculation_2685338603102213]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure] &lt;= 12 THEN &quot;0–12 months&quot;&#13;&#10;ELSEIF [tenure] &lt;= 24 THEN &quot;13–24 months&quot;&#13;&#10;ELSEIF [tenure] &lt;= 48 THEN &quot;25–48 months&quot;&#13;&#10;ELSE &quot;49–72 months&quot;&#13;&#10;END' />
      </column>
